{
  "name": "chipcheck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "vitest run --config vitest.rules.config.mts",
    "test:e2e": "playwright test",
    "test:e2e:local": "firebase emulators:exec --only firestore,auth --project demo-chipcheck \"playwright test\"",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "emulate": "firebase emulators:exec --only firestore,auth --project demo-chipcheck"
  },
  "dependencies": {
    "@nextui-org/react": "^2.6.11",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.41.0",
    "next": "14.2.35",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vercel/config": "^0.7.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "firebase-tools": "^15.29.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
