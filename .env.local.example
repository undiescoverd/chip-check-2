# Chip Check v2 — environment variables (chipcheck_v2.md §26)
#
# Copy to .env.local for local runs. The cloud sandbox and Vercel get their values
# from their own environment settings — .env.local is NEVER committed.
# Secrets are generated and pasted by Ian; the agent never generates or echoes them.

# --- Firebase: client (safe to expose; Firestore rules are the security boundary) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=            # <project>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase: server only ---
FIREBASE_SERVICE_ACCOUNT_JSON=               # base64 of the service-account JSON, one line
                                             # base64 -i key.json | tr -d '\n'

# --- App secrets: server only ---
STAFF_SESSION_SECRET=                        # openssl rand -base64 48 — signs staff cookies
CRON_SECRET=                                 # openssl rand -base64 48 — Vercel sends as Bearer
SUPERADMIN_UIDS=                             # comma-separated Firebase UIDs allowed on /admin

# --- Billing (feature-flagged; off for the pilot) ---
BILLING_ENABLED=false                        # Firestore config/flags.billingEnabled overrides this
STRIPE_SECRET_KEY=                           # required only when BILLING_ENABLED=true
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=          # not needed for hosted Checkout; reserved

# --- Site ---
NEXT_PUBLIC_SITE_URL=                        # e.g. https://chipcheck.example — QR + Stripe returns
NEXT_PUBLIC_DEMO_SLUG=                       # optional; "See a demo board" link on /

# --- Test harness only (§28) — NOT application configuration ---
# The app never reads these. They belong in the sandbox and CI environments, not in Vercel,
# and they point the integration scripts at a seeded test shop.
E2E_BASE_URL=                                # Preview URL the Playwright suite runs against
E2E_SHOP_SLUG=                               # the test shop's slug (test-shop)
E2E_STAFF_PIN=                               # that shop's staff PIN — scripts/orders-smoke.sh
                                             # exchanges it for a cc_staff cookie (§7.2), and
                                             # scripts/seed-shop.mjs --pin=… is what sets it
